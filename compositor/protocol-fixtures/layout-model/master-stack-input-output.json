{
  "schema": "agora-de.layout-model.planner-input-output.v1",
  "description": "Backend-neutral master-stack planner fixture. Planned rectangles are desired placements produced by Rust layout-model. Backend acknowledgement geometry remains the final compositor truth after an adapter applies the plan.",
  "boundary": {
    "planner_input": [
      "output work area",
      "reserved shell chrome",
      "workspace id",
      "visible normal surfaces",
      "surface order",
      "focus order",
      "participation",
      "selected layout rule",
      "gaps",
      "nmaster",
      "mfact"
    ],
    "planner_output": [
      "desired rectangles",
      "zone membership",
      "surface order",
      "focus order",
      "next revision",
      "command result classes"
    ],
    "backend_acknowledgement": [
      "post-placement geometry",
      "backend-supported or backend-unsupported outcome",
      "final visibility and focus state"
    ]
  },
  "input": {
    "rule": "master_stack",
    "revision": 5,
    "output": {
      "x": 0,
      "y": 0,
      "width": 1000,
      "height": 800
    },
    "reserved_chrome": {
      "top": 0,
      "right": 0,
      "bottom": 0,
      "left": 0
    },
    "workspace_id": "workspace-1",
    "settings": {
      "gaps": {
        "outer_horizontal": 10,
        "outer_vertical": 20,
        "inner_horizontal": 8,
        "inner_vertical": 4
      },
      "nmaster": 1,
      "mfact": 0.6,
      "smart_gaps": false
    },
    "surfaces": [
      {
        "surface_id": "view-a",
        "workspace_id": "workspace-1",
        "participation": "tiled",
        "order": 0,
        "focused": true
      },
      {
        "surface_id": "view-b",
        "workspace_id": "workspace-1",
        "participation": "tiled",
        "order": 1,
        "focused": false
      },
      {
        "surface_id": "view-c",
        "workspace_id": "workspace-1",
        "participation": "tiled",
        "order": 2,
        "focused": false
      }
    ],
    "focus_order": [
      "view-a",
      "view-b",
      "view-c"
    ]
  },
  "expected_plan": {
