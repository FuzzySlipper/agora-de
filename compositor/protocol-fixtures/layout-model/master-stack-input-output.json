          "x": 601,
          "y": 20,
          "width": 389,
          "height": 378
        },
        "order": 1
      },
      {
        "surface_id": "view-c",
        "workspace_id": "workspace-1",
        "zone_id": "stack",
        "participation": "tiled",
        "desired_geometry": {
          "x": 601,
          "y": 402,
          "width": 389,
          "height": 378
        },
        "order": 2
      }
