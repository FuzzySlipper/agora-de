[Unit]
Description=Agora DE compositor bridge
Wants=network.target
After=network.target

[Service]
Type=simple
ExecStartPre=/usr/bin/install -d -o root -g agents -m 0775 /run/agent-os
Environment=AGORA_COMPOSITOR_UID=1001
Environment=AGORA_COMPOSITOR_GID=1002
ExecStart=/usr/local/bin/agora-de-compositor-bridge
Restart=on-failure
RestartSec=2s
User=root
Group=root
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
