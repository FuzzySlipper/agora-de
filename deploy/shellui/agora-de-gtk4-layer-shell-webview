#!/usr/bin/env python3
"""GTK4/WebKit 6 layer-shell webview helper for installed agora-de chrome."""

from __future__ import annotations

import argparse
import json
import sys


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Launch an agora-de GTK4/WebKit layer-shell surface."
    )
    parser.add_argument("--url", required=True)
    parser.add_argument("--role", choices=("background", "panel", "overlay"), required=True)
    parser.add_argument("--width", type=int, required=True)
    parser.add_argument("--height", type=int, required=True)
    parser.add_argument("--title", required=True)
    parser.add_argument("--app-id", required=True)
    args = parser.parse_args()

    try:
        import gi

        gi.require_version("Gdk", "4.0")
        gi.require_version("Gtk", "4.0")
        gi.require_version("WebKit", "6.0")
        gi.require_version("Gtk4LayerShell", "1.0")
        from gi.repository import Gdk, Gio, GLib, Gtk, Gtk4LayerShell, WebKit
    except Exception as exc:
        print(f"DEPENDENCY_MISSING GTK4 stack: {exc}", flush=True)
        return 2

    class ShellSurfaceApp(Gtk.Application):
        def __init__(self) -> None:
            GLib.set_prgname(args.app_id)
            GLib.set_application_name(args.title)
            super().__init__(
                application_id=args.app_id,
                flags=Gio.ApplicationFlags.FLAGS_NONE,
            )
            self.window = None

        def do_activate(self) -> None:
            self.window = Gtk.ApplicationWindow(application=self)
            self.window.set_title(args.title)
            self.window.set_default_size(args.width, args.height)
            configure_layer_shell(Gtk4LayerShell, self.window, args.role, args.app_id)

            webview = WebKit.WebView()
            if args.role == "overlay":
                rgba = Gdk.RGBA()
                rgba.red = 0.0
                rgba.green = 0.0
                rgba.blue = 0.0
                rgba.alpha = 0.0
                webview.set_background_color(rgba)
            webview.load_uri(args.url)
            self.window.set_child(webview)
            self.window.connect("destroy", lambda *_args: self.quit())
            self.window.present()

            print(
                json.dumps(
                    {
                        "event": "shown",
                        "toolkit": "gtk4",
                        "role": args.role,
                        "appId": args.app_id,
                        "url": args.url,
                    },
                    sort_keys=True,
                ),
                flush=True,
            )

    return ShellSurfaceApp().run([])


def configure_layer_shell(Gtk4LayerShell, window, role: str, namespace: str) -> None:
    if not Gtk4LayerShell.is_supported():
        raise RuntimeError("Gtk4LayerShell is not supported on this Wayland display")

    Gtk4LayerShell.init_for_window(window)
    Gtk4LayerShell.set_namespace(window, namespace)
    if role == "background":
        Gtk4LayerShell.set_layer(window, Gtk4LayerShell.Layer.BOTTOM)
        for edge in (
            Gtk4LayerShell.Edge.TOP,
            Gtk4LayerShell.Edge.BOTTOM,
            Gtk4LayerShell.Edge.LEFT,
            Gtk4LayerShell.Edge.RIGHT,
        ):
            Gtk4LayerShell.set_anchor(window, edge, True)
        return

    if role == "overlay":
        Gtk4LayerShell.set_layer(window, Gtk4LayerShell.Layer.TOP)
        for edge in (
            Gtk4LayerShell.Edge.TOP,
            Gtk4LayerShell.Edge.BOTTOM,
            Gtk4LayerShell.Edge.LEFT,
            Gtk4LayerShell.Edge.RIGHT,
        ):
            Gtk4LayerShell.set_anchor(window, edge, True)
        if hasattr(Gtk4LayerShell, "KeyboardMode") and hasattr(Gtk4LayerShell, "set_keyboard_mode"):
            Gtk4LayerShell.set_keyboard_mode(window, Gtk4LayerShell.KeyboardMode.NONE)
        return

    Gtk4LayerShell.set_layer(window, Gtk4LayerShell.Layer.TOP)
    Gtk4LayerShell.set_anchor(window, Gtk4LayerShell.Edge.BOTTOM, True)
    Gtk4LayerShell.auto_exclusive_zone_enable(window)


if __name__ == "__main__":
    raise SystemExit(main())
