#!/usr/bin/env bash
# Foreground supervisor for the Agora DE shell panel user service.
set -euo pipefail
IFS=$'\n\t'

COMPOSITORCTL=${COMPOSITORCTL:-/home/agent/.local/bin/agora-de-compositorctl}
WEBVIEW_LAUNCHER=${WEBVIEW_LAUNCHER:-${AGORA_DE_SHELL_WEBVIEW_LAUNCHER:-$HOME/.local/bin/agora-de-gtk4-layer-shell-webview}}
SURFACE_URL=${AGORA_DE_SHELL_SURFACE_URL:-${AGORA_DE_SHELL_PANEL_URL:-http://127.0.0.1:17780/shell/dist/desktop/?surface=dock}}
SURFACE_ROLE=${AGORA_DE_SHELL_SURFACE_ROLE:-${AGORA_DE_SHELL_PANEL_ROLE:-panel}}
SURFACE_TITLE=${AGORA_DE_SHELL_SURFACE_TITLE:-${AGORA_DE_SHELL_PANEL_TITLE:-AGORA-DE-SHELL-PANEL}}
SURFACE_APP_ID=${AGORA_DE_SHELL_SURFACE_APP_ID:-${AGORA_DE_SHELL_PANEL_APP_ID:-io.agorade.ShellPanel}}
SURFACE_WIDTH=${AGORA_DE_SHELL_SURFACE_WIDTH:-${AGORA_DE_SHELL_PANEL_WIDTH:-2560}}
SURFACE_HEIGHT=${AGORA_DE_SHELL_SURFACE_HEIGHT:-${AGORA_DE_SHELL_PANEL_HEIGHT:-96}}
CLOSE_EXISTING=${AGORA_DE_SHELL_SURFACE_CLOSE_EXISTING:-true}
WAIT_TIMEOUT_MS=${AGORA_DE_SHELL_SURFACE_WAIT_TIMEOUT_MS:-${AGORA_DE_SHELL_PANEL_WAIT_TIMEOUT_MS:-8000}}
POLL_INTERVAL_SECONDS=${AGORA_DE_SHELL_SURFACE_POLL_INTERVAL_SECONDS:-${AGORA_DE_SHELL_PANEL_POLL_INTERVAL_SECONDS:-1}}

surface_id=""
launcher_pid=""
client_pid=""

log() {
  printf '%s %s\n' "$(date --iso-8601=seconds)" "$*" >&2
}

need() {
  command -v "$1" >/dev/null 2>&1 || { log "missing required command: $1"; exit 127; }
}

json_get() {
  local expr=$1 file=$2
  python3 - "$expr" "$file" <<'PY'
import json
import sys

expr = sys.argv[1]
path = sys.argv[2]
with open(path, "r", encoding="utf-8") as handle:
    value = json.load(handle)
for part in expr.split("."):
    if isinstance(value, dict):
        value = value.get(part)
    else:
        value = None
    if value is None:
        break
if value is not None:
    print(value)
PY
}

find_panel_surface() {
  "$COMPOSITORCTL" list-surfaces | python3 -c '
import json
import sys

app_id = sys.argv[1]
role = sys.argv[2]
launcher_pid = sys.argv[3]
data = json.load(sys.stdin)
matches = []
for item in data.get("surfaces", []):
    surface = item.get("surface") or {}
    if surface.get("app_id") != app_id or surface.get("role") != role:
        continue
    client = item.get("client") or {}
    if launcher_pid and str(client.get("pid") or "") != launcher_pid:
        continue
    matches.append((item.get("updated_at") or "", item))
if not matches:
    raise SystemExit(1)
_, item = sorted(matches, key=lambda pair: pair[0])[-1]
surface = item.get("surface") or {}
client = item.get("client") or {}
print(json.dumps({
    "surface_id": surface.get("id") or "",
    "client_pid": client.get("pid") or "",
}))
' "$SURFACE_APP_ID" "$SURFACE_ROLE" "${launcher_pid:-}"
}

close_existing_surfaces() {
  "$COMPOSITORCTL" list-surfaces | python3 -c '
import json
import sys

app_id = sys.argv[1]
role = sys.argv[2]
data = json.load(sys.stdin)
for item in data.get("surfaces", []):
    surface = item.get("surface") or {}
    if surface.get("app_id") == app_id and surface.get("role") == role:
        surface_id = surface.get("id") or ""
        client = item.get("client") or {}
        pid = client.get("pid") or ""
        if surface_id:
            print(f"{surface_id}\t{pid}")
' "$SURFACE_APP_ID" "$SURFACE_ROLE" | while IFS= read -r existing_surface; do
    surface_to_close=${existing_surface%%$'\t'*}
    pid_to_kill=${existing_surface#*$'\t'}
    if [[ "$pid_to_kill" == "$existing_surface" ]]; then
      pid_to_kill=""
    fi
    log "terminating stale Agora DE shell surface_id=$surface_to_close app_id=$SURFACE_APP_ID role=$SURFACE_ROLE pid=${pid_to_kill:-unknown}"
    if [[ -n "$pid_to_kill" ]]; then
      kill "$pid_to_kill" >/dev/null 2>&1 || true
    else
      "$COMPOSITORCTL" surface close --surface "$surface_to_close" >/dev/null 2>&1 || true
    fi
  done
}

surface_present() {
  local target_surface=$1
  "$COMPOSITORCTL" list-surfaces | python3 -c '
import json
import sys

target = sys.argv[1]
data = json.load(sys.stdin)
for item in data.get("surfaces", []):
    surface = item.get("surface") or {}
    if surface.get("id") == target:
        raise SystemExit(0)
raise SystemExit(1)
' "$target_surface"
}

process_present() {
  local pid=$1
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

cleanup() {
  local status=${1:-0}
  trap - TERM INT EXIT
  if [[ -n "$surface_id" ]]; then
    log "closing Agora DE shell surface_id=$surface_id"
    "$COMPOSITORCTL" surface close --surface "$surface_id" >/dev/null 2>&1 || true
  fi
  if [[ -n "$client_pid" ]]; then
    kill "$client_pid" >/dev/null 2>&1 || true
  fi
  if [[ -n "$launcher_pid" ]]; then
    kill "$launcher_pid" >/dev/null 2>&1 || true
  fi
  exit "$status"
}

trap 'cleanup 0' TERM INT
trap 'cleanup $?' EXIT

need "$COMPOSITORCTL"
need "$WEBVIEW_LAUNCHER"
need python3

webview_args=(
  "$WEBVIEW_LAUNCHER"
  --url "$SURFACE_URL"
  --role "$SURFACE_ROLE"
  --width "$SURFACE_WIDTH"
  --height "$SURFACE_HEIGHT"
  --title "$SURFACE_TITLE"
  --app-id "$SURFACE_APP_ID"
)

if [[ "$CLOSE_EXISTING" == "true" ]]; then
  close_existing_surfaces
fi

log "launching Agora DE shell surface: url=$SURFACE_URL role=$SURFACE_ROLE title=$SURFACE_TITLE app_id=$SURFACE_APP_ID size=${SURFACE_WIDTH}x${SURFACE_HEIGHT}"
"${webview_args[@]}" &
launcher_pid=$!

surface_json=$(mktemp -t agora-de-shell-panel-surface.XXXXXX.json)
rm -f "$surface_json"
deadline_ms=$(( $(date +%s%3N) + WAIT_TIMEOUT_MS ))
while true; do
  if find_panel_surface >"$surface_json"; then
    surface_id=$(json_get surface_id "$surface_json")
    client_pid=$(json_get client_pid "$surface_json")
    break
  fi
  if [[ $(date +%s%3N) -ge $deadline_ms ]]; then
    rm -f "$surface_json"
    log "shell surface launch did not map a matching surface before timeout"
    exit 1
  fi
  sleep 0.2
done
rm -f "$surface_json"

if [[ -z "$surface_id" ]]; then
  log "shell surface launch returned an empty surface id"
  exit 1
fi

if ! process_present "$launcher_pid"; then
  log "shell surface launcher process exited after mapping; monitoring client surface"
  launcher_pid=""
fi

log "Agora DE shell surface mapped surface_id=$surface_id launcher_pid=${launcher_pid:-exited} client_pid=${client_pid:-unknown}"

while true; do
  if ! surface_present "$surface_id"; then
    log "shell surface disappeared: $surface_id"
    exit 1
  fi
  if [[ -n "$client_pid" ]] && ! process_present "$client_pid"; then
    log "shell surface client process exited: $client_pid"
    exit 1
  fi
  sleep "$POLL_INTERVAL_SECONDS"
done
