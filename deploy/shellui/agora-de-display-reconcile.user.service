[Unit]
Description=Agora DE confirmed display profile reconciliation
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/agora-de/shellui.env
ExecStart=%h/.local/bin/agora-de-display-authority watch --state-dir %h/.config/agora-de/displays
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
